# Copy to .streamlit/secrets.toml for local development.
# For Streamlit Community Cloud, paste this into App settings → Secrets.
#
# ── Full EX rating leaderboard ──
# Baseline ratings: resources/ex_rating_baseline.csv (in repo, no ranks stored)
# Live rating patches: Supabase updated_ratings table (small fetch on page load)
# Top player scores: Supabase scores table (seed via sync_top_scores_to_supabase.py)
#
# Supabase → Connect → Transaction pooler URI (port 6543). Prefer transaction mode
# for multi-user Streamlit; session mode (5432) hits "max clients" quickly.
# If you paste a session-mode URI, the app rewrites pooler :5432 → :6543 automatically.

[supabase]
db_url = "postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres"
service_role_key = "YOUR_SERVICE_ROLE_KEY"
